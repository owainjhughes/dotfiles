{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/write-boundary.js\"",
            "timeout": 10,
            "statusMessage": "Checking file paths stay inside the allowed roots..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/ask-git-gate.js\"",
            "timeout": 10,
            "statusMessage": "Checking for git add/commit/push/PR..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-lock.js\"",
            "timeout": 10,
            "statusMessage": "Checking the checkout's session lock..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/session-lock.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/comment-gate.js\"",
            "timeout": 15,
            "statusMessage": "Checking for unnecessary comments..."
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/herdr-pane-title.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/herdr-pane-title.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/herdr-pane-title.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/herdr-agent-state.ps1\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/comment-baseline.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "terraform@claude-plugins-official": false,
    "deploy-on-aws@claude-plugins-official": true,
    "pydantic-ai@claude-plugins-official": true,
    "neon@claude-plugins-official": true,
    "resend@claude-plugins-official": true,
    "redis-development@claude-plugins-official": true,
    "sentry-cli@claude-plugins-official": true,
    "codex@openai-codex": true,
    "dak@data-agent-kit-starter-pack-marketplace": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "data-agent-kit-starter-pack-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/gemini-cli-extensions/data-agent-kit-starter-pack.git"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "pluginConfigs": {
    "dak@data-agent-kit-starter-pack-marketplace": {
      "options": {
        "GCP_REGION": "asia-northeast1"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true
}
